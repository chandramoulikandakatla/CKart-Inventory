# ==============================================================================
# CampusKart Application Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=127.0.0.1
ALLOWED_ORIGINS=*

# Security Secret (Replace with 64-character hex in production)
CAMPUSKART_SESSION_SECRET=a8f9c1d2e3f405162738495a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c

# Database Provider Selection: 'sqlite' | 'supabase' | 'postgres'
# Defaults to 'sqlite' if Supabase credentials are empty.
DATABASE_PROVIDER=sqlite
CAMPUSKART_DB_PATH=./backend/campuskart.db

# ------------------------------------------------------------------------------
# Supabase Cloud Configuration
# ------------------------------------------------------------------------------
# 1. PostgREST REST API mode (Zero extra dependencies, HTTPS based):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Direct PostgreSQL Connection mode (Pooler / Direct DB connection via psycopg2):
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8080
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
